{
  "name": "PUI Alert Router",
  "nodes": [
    {
      "parameters": {
        "path": "grafana-alert",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "id": "WebhookNode",
      "name": "grafana-webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $json;\nconst title = payload.title || payload.message || 'Grafana Alert';\nconst severity = payload?.alerts?.[0]?.labels?.severity || payload?.commonLabels?.severity || 'warning';\nconst service = payload?.alerts?.[0]?.labels?.service_name || 'unknown';\nconst status = payload.status || payload?.alerts?.[0]?.status || 'firing';\nconst summary = payload?.alerts?.[0]?.annotations?.summary || payload?.commonAnnotations?.summary || '';\nreturn [{ json: { title, severity, service, status, summary, raw: payload } }];"
      },
      "id": "NormalizeAlert",
      "name": "Normalize Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TEAMS_WEBHOOK_URL || '' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": `PUI Alert ${$json.status}: ${$json.title} | severity=${$json.severity} | service=${$json.service} | ${$json.summary}`\n}",
        "options": {}
      },
      "id": "TeamsWebhook",
      "name": "Send Teams Message",
      "continueOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "resource": "email",
        "fromEmail": "alerts@local",
        "toEmail": "team@local",
        "subject": "=PUI Alert {{$json.status}}: {{$json.title}}",
        "emailType": "text",
        "message": "=Severity: {{$json.severity}}\nService: {{$json.service}}\nSummary: {{$json.summary}}"
      },
      "id": "SendEmail",
      "name": "Send Email",
      "continueOnFail": true,
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        280
      ],
      "credentials": {
        "smtp": {
          "id": "mailhog-smtp",
          "name": "MailHog SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL || '' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": `PUI Alert ${$json.status}: ${$json.title} (${ $json.severity })`\n}",
        "options": {}
      },
      "id": "SlackWebhook",
      "name": "Send Slack Message",
      "continueOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": true,\n  \"handled\": true\n}"
      },
      "id": "Respond",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        980,
        280
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "grafana-webhook": {
      "main": [
        [
          {
            "node": "Normalize Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Alert": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "00000000-0000-0000-0000-000000000001",
  "meta": {
    "instanceId": "local-demo"
  },
  "id": "pui-alert-router"
}
